# Copy to .env, chmod 600 .env, and replace every REPLACE_* value.
# Never commit the resulting .env.

# Immutable or explicitly versioned runtime image. Do not use :latest.
OLLAMA_IMAGE=REPLACE_WITH_PINNED_OLLAMA_IMAGE_TAG_OR_DIGEST

# Canonical GPU identity: UUID, not ordinal index.
# Target: RTX 3090 24GB. Until the upgrade, use the current RTX 3080 UUID.
GPU_COMPUTE_UUID=GPU-REPLACE_WITH_COMPUTE_UUID

OPENHUMAN_SRC=/opt/ai-src/openhuman
VOICEBOX_SRC=/opt/ai-src/voicebox

OLLAMA_MODELS_DIR=/AI-modells/ollama
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=32
OLLAMA_NO_CLOUD=1

# Required for OpenHuman /rpc.
OPENHUMAN_CORE_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
OPENHUMAN_CORE_MEM_LIMIT=8g
OPENHUMAN_CORE_CPUS=4.0
RUST_LOG=info

VOICEBOX_OUTPUT_DIR=/AI-modells/Voicebox/output
VOICEBOX_HF_CACHE=/ai-cache/voicebox-hf
VOICEBOX_MEM_LIMIT=8g
VOICEBOX_CPUS=4.0
VOICEBOX_LOG_LEVEL=info
